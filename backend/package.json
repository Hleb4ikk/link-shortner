    "format": "prettier src --write"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.4.0",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  }
}
