{
  "name": "project-root",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "prepare": "npx husky .husky",
    "dev": "npm run dev:backend",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm run build:backend",
    "build:backend": "npm --workspace backend run build",
    "start:prod": "npm --workspace backend run start:prod",
    "lint": "eslint backend/src --ext .ts,.tsx,.js,.jsx --config eslint.config.mts",
    "format": "prettier backend/src --write"
  },
  "lint-staged": {
    "{frontend,backend}/src/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "eslint": "9.35.0",
    "husky": "9.1.7",
    "jiti": "2.5.1",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2"
  }
}
